CONFIG_PROJECT_NAME="aipet"
CONFIG_BOARD_CHOICE_T5AI=y
CONFIG_BOARD_CHOICE_TUYA_T5AI_BOARD=y
CONFIG_TUYA_T5AI_BOARD_LCD_35565=y
#
# 2026-10-16 排查摄像头时试过把上面那行注释掉来"关掉 LCD" —— **没用**：
# `ENABLE_LIBLVGL` 会 `select ENABLE_DISPLAY`（src/liblvgl/Kconfig:3），
# 而本工程的 UI 全是 LVGL，所以注释掉 LCD 模块之后 ENABLE_DISPLAY 照样是 y，
# 板级 `__board_register_display()` 照样跑。真要摘掉 LCD 得改板级注册
# （`boards/T5AI/TUYA_T5AI_BOARD/tuya_t5ai_ex_module.c` 的 `AIPET_SKIP_DISPLAY`）。
#
# 下面这两个原本由 TUYA_T5AI_BOARD_LCD_35565 隐式 select，显式写出来是为了
# 别被 app_default.config 的往返静默带掉。
CONFIG_ENABLE_LVGL_OS_FREERTOS=y
CONFIG_ENABLE_LVGL_DUAL_DISP_BUFF=y

# ---- LVGL 9 ------------------------------------------------------------------
# 桌宠页全程用 LVGL 渲染（横屏 480x320，靠 lv_display_set_rotation(90°) 转过来）。
# 老产品的"游戏/角色页会挂起 LVGL、自己刷三缓冲"那套随那些页面删掉了，
# 现在没有 APP_PAGE_OWN_DISPLAY 的页面。
# 绘制缓冲放 PSRAM，给音频管线（AEC/Opus）省内部 SRAM。
CONFIG_ENABLE_AUDIO_AEC=y
CONFIG_ENABLE_LIBLVGL=y
CONFIG_LVGL_VERSION_9=y
CONFIG_LVGL_COLOR_DEPTH=16
CONFIG_ENABLE_LVGL_DRAW_BUF_PSRAM=y
# 单点 indev 够用（状态栏弹窗、宠物点击、备忘录列表都是单点）。
# 老产品那个多点虚拟手柄（app_ui.c）已经删了。
CONFIG_ENABLE_LVGL_TP=y
# CONFIG_ENABLE_LVGL_DEMO is not set
# CONFIG_ENABLE_LVGL_MONITOR is not set

# ---- P12 按键 ----------------------------------------------------------------
# GPIO12，低电平有效（内部上拉），由 app_key.c 轮询（30ms 一拍）。
# 短按 = 打断 AI 正在说的话；长按 = 弹设置（网络 / 音量）。见 page_pet.c 的
# prv_pet_key()。

# ---- AI 语音对话（TuyaOpen AI components）------------------------------------
CONFIG_TUYA_PRODUCT_ID="ha89ld9djelrng6x"
# ---- P12 / GPIO12 只能有一个主人 ---------------------------------------------
# 原来这里设了 CONFIG_BUTTON_NAME="ai_chat_button"，于是板级
#   boards/T5AI/TUYA_T5AI_BOARD/tuya_t5ai_board.c:24  BOARD_BUTTON_PIN = GPIO12
# 把 **同一个 P12** 又注册成了一颗 tdd_button（IRQ_FALL + PULLDOWN），AI 栈
# 拉起时 tdl_button_create() 还会再 tkl_gpio_init(12, PULLDOWN) 一次，而 app_key.c
# 那边是 INPUT+PULLUP 轮询。两个主人轮着改同一个引脚 ⇒ 长按偶发失效；而且长按在
# AI 栈里会触发 ai_mode_switch_next()（切模式 + 写 KV），和"长按弹设置"赛跑。
# 现在把 SDK 那一份摘掉，P12 只归 app_key.c。
# CONFIG_BUTTON_NAME="ai_chat_button"
CONFIG_ENABLE_MBEDTLS_SSL_MAX_CONTENT_LEN=4096
CONFIG_ENABLE_AI_LANGUAGE_CHINESE=y

# ---- AI 模式 / MCP -----------------------------------------------------------
# 下面三项在 SDK Kconfig 里的 default 就是 y，**显式写出来是为了别被
# app_default.config 的往返（IDE 里改配置会重写本文件）静默带掉**：
#
#   MODE_FREE   app_ai_chat.c 用的就是它：VAD 人声触发，**不需要唤醒词**
#               —— 对着设备说话就行，不用先进任何页面。
#   MODE_WAKEUP 老产品的唤醒词模式（"你好,涂鸦"）。留着无害（模式是运行时选的），
#               真按唤醒词走会要 KWS 模型常驻，费内存，不用就别开。
#   MCP         **对话驱动动作的命根子**。关掉的话 app_avatar_tools.c 会整个编译成
#               空壳（见它的 #if），云端也就拿不到本机工具 —— 表现是"宠物对
#               说话内容毫无反应，但语音正常"。
CONFIG_ENABLE_COMP_AI_MODE_FREE=y
CONFIG_ENABLE_COMP_AI_MODE_WAKEUP=y
CONFIG_ENABLE_COMP_AI_MCP=y

# ---- 摄像头（GC2145，DVP）----------------------------------------------------
# 板载的 GC2145 是**板级已适配**的设备（boards/T5AI/TUYA_T5AI_BOARD），所以
# board_register_hardware() 会把它注册好，我们不用写 TDD。
# 这一个开关会 select ENABLE_CAMERA 并定下 CAMERA_NAME="camera"，所以
# **不要**再手写 CONFIG_ENABLE_CAMERA / CONFIG_CAMERA_NAME。
CONFIG_TUYA_T5AI_BOARD_CAMERA=y

# AI 自带的 wechat 风格聊天 UI 不要 —— 桌宠页就是 UI。
# CONFIG_ENABLE_COMP_AI_DISPLAY is not set
