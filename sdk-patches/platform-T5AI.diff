--- a/t5_os/ap/middleware/driver/sd_card/sd_card_driver.c
+++ b/t5_os/ap/middleware/driver/sd_card/sd_card_driver.c
@@ -65,7 +65,13 @@ static sdcard_rw_state_t sd_card_check_continious_rw(sdcard_rw_ops_t ops, uint32
 #define DATA_TIMEOUT_6_5_M  208000
 
 #define CMD_TIMEOUT_13M		13000	//1ms, max retry_cnt 128(SD_CARD_MAX_CMD_TRIAL_COUNT)
-#define DATA_TIMEOUT_13M	416000	//32ms, max retry_cnt 128(SD_CARD_MAX_DATA_TRIAL_COUNT)
+/* 原值 416000(32ms)。真机实测（src/tests/app_sd_test.c，纯 SD 读、零负载）：
+ * 顺序读全过，**散读**在第 5 次上撞 `TODO:read data timeout error!!!` 且
+ * rx real cnt=0 —— 主控的数据超时到点时，卡一个字节都没发出来。
+ * SD 规范允许部分卡的读访问时间(TAAC)到 100ms，32ms 可能只是**比卡慢**而不是卡坏。
+ * 放大到 256ms 试一次：如果就好了，说明是超时太短；如果还挂，说明卡是真不响应。
+ * 代价：真挂住时最多等 256ms（比原来多 224ms），远小于 GDMA 那条路 5.12s 的死等。 */
+#define DATA_TIMEOUT_13M	3328000	//256ms, max retry_cnt 128(SD_CARD_MAX_DATA_TRIAL_COUNT)
 
 #define CMD_TIMEOUT_20M		20000	//1ms, max retry_cnt 128
 #define DATA_TIMEOUT_20M	640000	//32ms, max retry_cnt 128
@@ -96,6 +102,28 @@ typedef struct {
 	sdio_host_clock_freq_t clock_freq;
 } sd_card_obj_t;
 
+// Modified by TUYA Start
+/* aipet: 写通路 DMA 开关的全局覆盖（应用层可写，建卡时生效）。
+ *   -1 = 按配置走（默认开 DMA）
+ *    0 = 强制 CPU 写
+ *    1 = 强制 DMA 写
+ * 用途：SD 卡出现"能读、写块全错（wr_status=0x7）"时做一次 A/B —— 关掉 DMA
+ * 就能写说明问题在 GDMA TX 通路；仍旧写不进则指向卡/供电/卡座。
+ * 建卡时读一次，所以切换后必须重新 init（tkl_fs_unmount + bk_sd_card_deinit）。 */
+int g_sd_card_dma_tx_override = -1;
+
+/* aipet: 读通路 DMA 开关的全局覆盖（同样的 A/B 用法，建卡时生效）。
+ * 读通路就是"硬件读"和"软件轮询"的分界：dma_rx_en=1 走 GDMA，=0 走 CPU 搬 FIFO。
+ * 注意整段包在 CONFIG_SDIO_GDMA_EN 里 —— 配置关了的话这个覆盖不起作用，
+ * 所以另外导出一个 g_sd_card_dma_rx_compiled 让测试程序能如实报告。 */
+int g_sd_card_dma_rx_override = -1;
+#if CONFIG_SDIO_GDMA_EN
+int g_sd_card_dma_rx_compiled = 1;
+#else
+int g_sd_card_dma_rx_compiled = 0;
+#endif
+// Modified by TUYA End
+
 #if CONFIG_SDIO_V2P0
 static beken_mutex_t s_mutex_sdcard;
 #define CONFIG_SDCARD_OPS_TRACE_EN (0)
@@ -1078,8 +1106,10 @@ bk_err_t bk_sd_card_init(void)
 #endif
 // Modified by TUYA End
 #if CONFIG_SDIO_GDMA_EN
-	sdio_cfg.dma_tx_en = 1;
-	sdio_cfg.dma_rx_en = 1;
+	// Modified by TUYA Start
+	sdio_cfg.dma_tx_en = (g_sd_card_dma_tx_override < 0) ? 1 : (uint8_t)g_sd_card_dma_tx_override;
+	sdio_cfg.dma_rx_en = (g_sd_card_dma_rx_override < 0) ? 1 : (uint8_t)g_sd_card_dma_rx_override;
+	// Modified by TUYA End
 #endif
 	s_sd_card_obj.clock_freq = sdio_cfg.clock_freq;
 
@@ -1574,6 +1604,44 @@ bk_err_t bk_sd_card_read_blocks(uint8_t *data, uint32_t block_addr, uint32_t blo
 	uint32_t addr = block_addr;
 	sdio_host_data_config_t data_config = {0};
 
+	// Modified by TUYA Start
+	/* **单次传输不超过一个 DMA 段（64KB = DMA_LL_TRANS_LEN_MAX）。**
+	 *
+	 * 读通路开了 GDMA 时（CONFIG_SDIO_GDMA_EN + dma_rx_en），一次传输超过
+	 * 64KB 就要分段链式重启（sdio_dma_rx_finish / sdio_dma_rx_start）。真机实测
+	 * （src/tests/app_sd_hw_test.c，块层、零业务负载）：
+	 *   - 一次 64KB：GDMA 与 CPU 轮询逐字节一致，扫前 64MB 零差异；
+	 *   - 一次 792KB：GDMA 返回的数据有 ~35KB 是错的，同时刷
+	 *     `read data status err:int_status=0x00048588`。
+	 * 病在分段记账，不在 GDMA 本身。把大请求拆成 <=64KB 的连续小请求：
+	 * 地址连续，sd_card_check_continious_rw() 会当成同一次多块传输的延续，
+	 * 不重发 CMD18，吞吐不变（实测 64KB 6150KB/s，792KB 6106KB/s）。
+	 *
+	 * 不开 GDMA 时这条分支同样有益：CPU 轮询一次搬的字节数变短，单次持续
+	 * 占用的时间可控（WDT / 其它线程的延迟都更好）。
+	 *
+	 * 注意：这里递归调用自己，每次的 block_num 都 <=128，不会再进这条分支。 */
+	#define SDIO_READ_MAX_BLKS  128u		/* 64KB / 512B */
+	if (block_num > SDIO_READ_MAX_BLKS) {
+		uint32_t done = 0;
+
+		while (done < block_num) {
+			uint32_t n = block_num - done;
+			bk_err_t e;
+
+			if (n > SDIO_READ_MAX_BLKS) {
+				n = SDIO_READ_MAX_BLKS;
+			}
+			e = bk_sd_card_read_blocks(data + done * 512u, block_addr + done, n);
+			if (e != BK_OK) {
+				return e;
+			}
+			done += n;
+		}
+		return BK_OK;
+	}
+	// Modified by TUYA End
+
 	if(s_mutex_sdcard) {
 		rtos_lock_recursive_mutex(&s_mutex_sdcard);
 	}
