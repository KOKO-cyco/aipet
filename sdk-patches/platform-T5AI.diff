+static void __vad_apply_cmd(uint8_t cmd)
+{
+    switch (cmd) {
+    case VAD_CMD_START:
+        __s_aec_vad_flag = TKL_VAD_STATUS_NONE;
+        if (__s_rnn_vad_handle) {
+            rnn_vad_start(__s_rnn_vad_handle);
