+OPERATE_RET tkl_dvp_rotate_rgb565(const uint8_t *yuv, uint32_t w, uint32_t h,
+                                  uint16_t *dst, uint32_t *out_w, uint32_t *out_h)
+{
+    OPERATE_RET rt = __dvp_rot_run(yuv, w, h, dst, NULL);
+
+    if (NULL != out_w) {
+        *out_w = h;                     /* 转 90°：输出是 h 宽、w 高 */
+    }
+    if (NULL != out_h) {
+        *out_h = w;
+    }
+
+    return rt;
+}
+
+OPERATE_RET tkl_dvp_test_rotate(const uint8_t *yuv, uint32_t w, uint32_t h,
+                                uint32_t *out_ms, uint32_t *out_w,
+                                uint32_t *out_h, uint16_t **out_rgb)
+{
+    uint32_t      ms  = 0;
+    OPERATE_RET   rt;
+
+    if (NULL == out_ms || NULL == out_w || NULL == out_h || NULL == out_rgb) {
+        return OPRT_INVALID_PARM;
+    }
+
+    if (NULL == s_rot_buf || s_rot_w != h || s_rot_h != w) {
+        if (NULL != s_rot_buf) {
+            tkl_system_psram_free(s_rot_buf);
+            s_rot_buf = NULL;
+        }
+        s_rot_buf = (uint16_t *)tkl_system_psram_malloc((size_t)w * h * 2);
+        if (NULL == s_rot_buf) {
+            return OPRT_MALLOC_FAILED;
+        }
+        s_rot_w = h;
+        s_rot_h = w;
+    }
+
+    rt = __dvp_rot_run(yuv, w, h, s_rot_buf, &ms);
+
+    *out_ms  = ms;
+    *out_w   = s_rot_w;
+    *out_h   = s_rot_h;
+    *out_rgb = s_rot_buf;
+
+    return rt;
+}
