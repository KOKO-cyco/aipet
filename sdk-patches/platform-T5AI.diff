@@ -58,6 +58,15 @@ static bk_err_t yuv_buf_hal_set_config_common(yuv_buf_hal_t *hal, const yuv_buf_
 	yuv_buf_ll_enable_sync_edge_dect(hal->hw);
 	yuv_buf_ll_set_encode_begin_hsync_posedge(hal->hw);
 	yuv_buf_ll_disable_bps_cis(hal->hw);
+
+	/* aipet: GC2145 P0:0x84[4:0]=0x02 表示传感器输出 Y Cb Y Cr（YUYV）。
+	 * YUV BUF 的 bus_dat_byte_reve 位没有在初始化里设置过，默认状态下会把
+	 * 每组 4 字节整体反转，内存里变成 Cr Y Cb Y —— 这就是之前必须按 VYUY
+	 * 解析、ROTT 也认不出的原因。这里显式关掉，保持传感器原生顺序。 */
+	bk_printf("yuv_buf bus_dat_byte_reve=%d -> 0\n",
+	          hal->hw->ctrl.bus_dat_byte_reve);
+	yuv_buf_ll_disable_reverse_yuv_data(hal->hw);
+
 	yuv_buf_ll_disable_memrev(hal->hw);
 	yuv_buf_ll_enable_int(hal->hw);
 
