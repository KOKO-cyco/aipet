+OPERATE_RET tkl_dvp_test_rotate(const uint8_t *yuv, uint32_t w, uint32_t h,
+                                uint32_t *out_ms, uint32_t *out_w,
+                                uint32_t *out_h, uint16_t **out_rgb)
+{
+    rott_config_t cfg = { 0 };
+    bk_err_t      ret;
+    uint32_t      t0;
+
+    if (NULL == yuv || 0 == w || 0 == h || NULL == out_ms ||
+        NULL == out_w || NULL == out_h || NULL == out_rgb) {
+        return OPRT_INVALID_PARM;
+    }
+
+    if (NULL == s_rot_buf || s_rot_w != h || s_rot_h != w) {
+        if (NULL != s_rot_buf) {
+            tkl_system_psram_free(s_rot_buf);
+            s_rot_buf = NULL;
+        }
+        s_rot_buf = (uint16_t *)tkl_system_psram_malloc((size_t)w * h * 2);
+        if (NULL == s_rot_buf) {
+            return OPRT_MALLOC_FAILED;
+        }
+        s_rot_w = h;
+        s_rot_h = w;
+    }
+
+    if (NULL == s_rot_sem) {
+        if (kNoErr != rtos_init_semaphore_ex(&s_rot_sem, 1, 0)) {
+            s_rot_sem = NULL;
+            return OPRT_COM_ERROR;
+        }
+        bk_rott_driver_init();
+        bk_rott_int_enable(ROTATE_COMPLETE_INT | ROTATE_CFG_ERR_INT, 1);
+        bk_rott_isr_register(ROTATE_COMPLETE_INT, __rot_complete_isr);
+    }
+
+    cfg.rot_mode       = ROTATE_90;
+    cfg.input_addr     = (void *)yuv;
+    cfg.output_addr    = s_rot_buf;
+    /* 传感器按 P0:0x84=0x02 输出 Y Cb Y Cr；YUV BUF 的字节反转已在 HAL 层
+     * 关闭，内存里就是标准 YUYV，ROTT 可以直接吃。 */
+    cfg.input_fmt      = PIXEL_FMT_YUYV;
+    cfg.input_flow     = ROTT_INPUT_NORMAL;
+    cfg.output_flow    = ROTT_OUTPUT_NORMAL;
+    cfg.picture_xpixel = (uint16_t)w;
+    cfg.picture_ypixel = (uint16_t)h;
+
+    /* TABLE_ROTT_BLOCK 里没有 320×240，显式给块参数（80×60 × 4×4 = 16 块，
+     * 每块 4800 像素，正好是硬件上限）。 */
+    if (320 == w && 240 == h) {
+        cfg.block_xpixel = 80;
+        cfg.block_ypixel = 60;
+        cfg.block_cnt    = 16;
+        /* watermark 不能留 0：SDK 的 TABLE_ROTT_BLOCK 每一档都填 block_cnt/2
+         * （640x480: 64/32、320x480: 32/16、480x480: 48/40），它是硬件乒乓
+         * 缓冲的切换点，留 0 不合约定。 */
+        cfg.watermark_blk = 8;
+    }
+
+    s_rot_done = false;
+    t0 = tkl_system_get_millisecond();
+
+    ret = rott_config(&cfg);
+    if (BK_OK != ret) {
+        return OPRT_COM_ERROR;
+    }
+
+    bk_rott_enable();
+    rtos_get_semaphore(&s_rot_sem, TKL_DVP_ROT_TIMEOUT_MS);
+
+    *out_ms  = tkl_system_get_millisecond() - t0;
+    *out_w   = s_rot_w;
+    *out_h   = s_rot_h;
+    *out_rgb = s_rot_buf;
+
+#if CONFIG_CACHE_ENABLE
+    invalidate_dcache(s_rot_buf, (long)(w * h * 2));
+#endif
+
+    return s_rot_done ? OPRT_OK : OPRT_TIMEOUT;
+}
