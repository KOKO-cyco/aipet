+OPERATE_RET tkl_kws_deinit(void)
+{
+    if (false == sg_kws_mgr.init) {
+        return OPRT_OK;
+    }
+
+    tkl_kws_disable();
+
+    /* Stop the detect task. It releases its own thread handle and clears
+     * sg_kws_mgr.thread on exit -- poll that as the exit handshake, so the
+     * buffers below are never freed under a running detect() call. */
+    sg_kws_mgr.thread_running = false;
+    tkl_semaphore_post(sg_kws_mgr.sem);
+    while (NULL != sg_kws_mgr.thread) {
+        tkl_system_sleep(20);
+    }
+
+    tuya_ring_buff_free(sg_kws_mgr.rb);
+    tkl_mutex_release(sg_kws_mgr.mutex);
+    tkl_semaphore_release(sg_kws_mgr.sem);
+    if (NULL != sg_kws_mgr.oneframe) {
+        tkl_system_psram_free(sg_kws_mgr.oneframe);
+        sg_kws_mgr.oneframe = NULL;
+    }
+    if (NULL != sg_kws_mgr.buffer) {
+        tkl_system_psram_free(sg_kws_mgr.buffer);
+        sg_kws_mgr.buffer = NULL;
+    }
+#ifdef __EN_EXTERNALLY_ALLOCATION__
+    if (NULL != pExternallyAllocatedMem) {
+        psram_free(pExternallyAllocatedMem);
+        pExternallyAllocatedMem = NULL;
+    }
+    sg_tutuclear_obj = NULL;
+#endif
+
+    memset(&sg_kws_mgr, 0, sizeof(sg_kws_mgr));
+
+    return OPRT_OK;
+}
