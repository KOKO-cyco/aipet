+         */
+        if (cfg.aec_en)
+        {
+            if ((cfg.aec_cfg.aec_alg_cfg.aec_cfg.mode == AEC_MODE_HARDWARE && cfg.mic_cfg.onboard_mic_cfg.adc_cfg.chl_num != 2)
