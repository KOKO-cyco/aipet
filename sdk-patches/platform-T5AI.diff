+            {
+                BK_LOGE(TAG, "%s, %d, aec mode: %d, mic chanels: %d are not support\n", __func__, __LINE__, cfg.aec_cfg.aec_alg_cfg.aec_cfg.mode, cfg.mic_cfg.uac_mic_cfg.chl_num);
+                return BK_FAIL;
+            }
+        }
+    }
+    else if (cfg.mic_type == MIC_TYPE_ONBOARD_DUAL_DMIC_MIC)
