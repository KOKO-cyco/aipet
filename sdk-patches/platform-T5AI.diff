+        break;
+    case VAD_CMD_STOP:
+        __s_aec_vad_flag = TKL_VAD_STATUS_NONE;
+        if (__s_rnn_vad_handle) {
+            rnn_vad_stop(__s_rnn_vad_handle);
+        }
+        break;
+    case VAD_CMD_RESTART:
