+/* 16bit 单声道帧峰值 -> 整数 dBFS 近似（每进一位 6dB）。
+ * 用来区分"收不到人声"的三种物理原因：
+ *   mic 也安静   -> 麦克风/采集链路没数据
+ *   mic 有声但 aec 静 -> AEC/NS 把输出压死了（回声消除跑飞）
+ *   两个都有声但 raw=0  -> RNN VAD 自己卡死
+ * 值域严格是 [-96, -12]：peak=32767 右移 15 次到 1，故满量程读数 -12（不是 -6）。
+ * 这个范围也说明：日志里出现的 0dB / 超大正数一定是输出被并发写串口污染了，不可信。 */
+static int16_t __vad_peak_dbfs(const int16_t *p, uint32_t n)
+{
+    uint32_t peak = 0;
+    int16_t  db   = -96;
+
+    if (NULL == p || 0 == n) {
+        return -96;
+    }
+
+    for (uint32_t i = 0; i < n; i++) {
+        int32_t  v = p[i];
+        uint32_t a = (uint32_t)((v < 0) ? -v : v);
+        if (a > peak) {
+            peak = a;
+        }
+    }
+
+    while (peak > 1) {
+        peak >>= 1;
+        db   += 6;
+    }
+
+    return db;
+}
