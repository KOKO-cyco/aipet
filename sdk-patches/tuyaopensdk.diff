+     * up is unchanged (check_auto_upgrade_timeout_on re-arms itself). */
+    tal_sw_timer_stop(client->check_upgrade_timer);
+    tal_sw_timer_start(client->check_upgrade_timer, 1000 * 1, TAL_TIMER_ONCE);
 
