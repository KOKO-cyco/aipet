@@ -46,7 +46,38 @@ const uint8_t cILI9488_INIT_SEQ[] = {
 static TDD_DISP_RGB_CFG_T sg_disp_rgb = {
     .cfg =
         {
-            .clk = 15000000,
+            /* RGB pixel clock. Frame size incl. blanking is
+             *   (320 + hbp 80 + hfp 80 + hpw 20) * (480 + vbp 8 + vfp 8 + vpw 4)
+             * = 500 * 500 = 250000 clocks, so refresh = clk / 250000:
+             *   8MHz -> 32Hz, 10MHz -> 40Hz, 15MHz -> 60Hz, 20MHz -> 80Hz.
+             * (Only the discrete values in tkl_rgb.c's
+             *  __rgb_ty_clk_to_bk_clk() switch are accepted; anything else
+             *  silently falls through to 30MHz.)
+             *
+             * 20MHz / 80Hz. The panel MUST refresh noticeably faster than the
+             * emulator produces frames, for three separate reasons:
+             *
+             *  1. tdd_display_rgb's __rgb_display_frame() hands the next buffer
+             *     over and then blocks on flush_sem until a panel frame ends, so
+             *     the rgb_task drains at most ONE flush per panel frame. If the
+             *     panel is slower than the producer, the flush queue backs up and
+             *     __tdd_display_rgb_flush()'s tal_queue_post(SEM_WAIT_FOREVER)
+             *     stalls the producer's frame loop. That is what capped the NES
+             *     emulator at ~57fps and, because audio production is tied 1:1 to
+             *     emulated frames, drained the speaker ring buffer until the
+             *     music stuttered continuously.
+             *  2. With double buffering, the ping-pong swap must complete before
+             *     the producer starts writing the other buffer, otherwise it
+             *     tears into the buffer still being scanned. A panel period
+             *     shorter than the emulator's frame period guarantees that.
+             *  3. A 40Hz panel simply cannot show 60 frames per second.
+             *
+             * At 80Hz against a 60.099Hz emulator there is 33% headroom. Cost is
+             * PSRAM read bandwidth (320*480*2 * 80/s = 24.6MB/s); the NES core
+             * idles at ~85%, so that is free.
+             * NOTE: this is a shared SDK driver, so it affects every board
+             * using the ILI9488 RGB path. */
+            .clk = 20000000,
             .out_data_clk_edge = TUYA_RGB_DATA_IN_RISING_EDGE,
             .pixel_fmt = TUYA_PIXEL_FMT_RGB565,
             .hsync_back_porch = 80,
