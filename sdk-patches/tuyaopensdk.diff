--- a/src/liblvgl/v9/port/lv_port_disp_full_frame.c
+++ b/src/liblvgl/v9/port/lv_port_disp_full_frame.c
@@ -208,6 +208,138 @@ static void __disp_fill_display_framebuffer(const lv_area_t *area, uint8_t *px_m
     }
 }
 
+/* ---- 换 fb 时只同步脏矩形 ----
+ *
+ * 原来每一次刷新结束，都会把整块 framebuffer（320×480×2 = 307KB）拷到下一块
+ * fb（读+写 614KB PSRAM），哪怕只更新了一个时钟。LVGL 是 PARTIAL 渲染模式，
+ * 每轮只把实际脏区写进 disp_fb，所以"把本轮脏区同步进下一块 fb"就够了。
+ *
+ * 关键判据：RGB 驱动的 ISR 换帧时释放的正好是"本次绘制之前的上一帧"那块 fb
+ * （next_fb == sg_last_disp_fb）。匹配 -> next_fb 里就是上一帧的完整画面，
+ * 只把本轮脏矩形拷进去即与 disp_fb 一致；不匹配（首上电、脏矩形溢出、
+ * 池子顺序异常）-> 退回整屏拷贝，保证一定对。
+ *
+ * 显示释放 / 恢复（on_enable / release）时清状态，避免悬空指针。 */
+#define LV_PORT_DIRTY_MAX   32
+
+static struct {
+    lv_area_t               rect[LV_PORT_DIRTY_MAX];
+    uint8_t                 n;
+    bool                    overflow;
+    bool                    first;                     /**< 首上电：没上一帧可对 */
+    TDL_DISP_FRAME_BUFF_T  *last_disp_fb;              /**< 上一轮送显的那块 */
+} s_fb_dirty;
+
+/** 记一块脏区（面板坐标）。相交的自动并起来；超过 32 块置溢出标志。 */
+static void __disp_dirty_add(const lv_area_t *area, TDL_DISP_FRAME_BUFF_T *fb)
+{
+    lv_area_t a = *area;
+
+    if (NULL == fb) {
+        return;
+    }
+    if (a.x2 < 0 || a.y2 < 0 ||
+        a.x1 >= (int)fb->width || a.y1 >= (int)fb->height) {
+        return;
+    }
+    if (a.x1 < 0)                a.x1 = 0;
+    if (a.y1 < 0)                a.y1 = 0;
+    if (a.x2 >= (int)fb->width)  a.x2 = fb->width - 1;
+    if (a.y2 >= (int)fb->height) a.y2 = fb->height - 1;
+
+    for (uint8_t i = 0; i < s_fb_dirty.n; i++) {
+        lv_area_t hit;
+
+        if (_lv_area_intersect(&hit, &s_fb_dirty.rect[i], &a)) {
+            _lv_area_join(&s_fb_dirty.rect[i], &s_fb_dirty.rect[i], &a);
+            return;
+        }
+    }
+
+    if (s_fb_dirty.n < LV_PORT_DIRTY_MAX) {
+        s_fb_dirty.rect[s_fb_dirty.n++] = a;
+    } else {
+        s_fb_dirty.overflow = true;    /* 本轮改判整屏拷贝 */
+    }
+}
+
+/** 只把 rects[0..n) 从 src_frame 拷到 dst_frame（两块同为 fb 步距）。
+ *  DMA2D 编译进来时按矩形走 DMA2D（axis = 矩形原点，width_cp/height_cp =
+ *  矩形尺寸）；否则按行 memcpy。 */
+static void __disp_fb_rect_copy(TDL_DISP_DEV_INFO_T *dev_info,
+                                uint8_t *dst_frame, uint8_t *src_frame,
+                                const lv_area_t *rects, uint8_t n)
+{
+    uint32_t bpp    = (tdl_disp_get_fmt_bpp(dev_info->fmt) + 7) / 8;
+    uint32_t stride = dev_info->width * bpp;
+
+    for (uint8_t i = 0; i < n; i++) {
+        const lv_area_t *r = &rects[i];
+        uint32_t w, h;
+
+        if (r->x2 < r->x1 || r->y2 < r->y1) {
+            continue;
+        }
+        w = (uint32_t)(r->x2 - r->x1 + 1);
+        h = (uint32_t)(r->y2 - r->y1 + 1);
+#if defined(ENABLE_DMA2D) && (ENABLE_DMA2D == 1)
+        if (NULL != sg_lvgl_dma2d_hdl) {
+            TKL_DMA2D_FRAME_INFO_T in_frame  = {0};
+            TKL_DMA2D_FRAME_INFO_T out_frame = {0};
+
+            switch (dev_info->fmt) {
+                case TUYA_PIXEL_FMT_RGB565:
+                    in_frame.type  = TUYA_FRAME_FMT_RGB565;
+                    out_frame.type = TUYA_FRAME_FMT_RGB565;
+                    break;
+                case TUYA_PIXEL_FMT_RGB888:
+                    in_frame.type  = TUYA_FRAME_FMT_RGB888;
+                    out_frame.type = TUYA_FRAME_FMT_RGB888;
+                    break;
+                default:
+                    return;                 /* 别的格式不做矩形拷 */
+            }
+
+            /* 两块 fb 都是"整帧 + 轴偏移 + 拷贝区域"的描述法，见
+             * __dma2d_cfg_init：width/height 是帧步距，axis 是帧内起点，
+             * width_cp/height_cp 才是这次拷多大。 */
+            in_frame.width     = dev_info->width;
+            in_frame.height    = dev_info->height;
+            in_frame.pbuf      = src_frame;
+            in_frame.axis.x_axis = r->x1;
+            in_frame.axis.y_axis = r->y1;
+            in_frame.width_cp  = w;
+            in_frame.height_cp = h;
+
+            out_frame.width     = dev_info->width;
+            out_frame.height    = dev_info->height;
+            out_frame.pbuf      = dst_frame;
+            out_frame.axis.x_axis = r->x1;
+            out_frame.axis.y_axis = r->y1;
+            out_frame.width_cp  = w;
+            out_frame.height_cp = h;
+
+            tal_dma2d_memcpy(sg_lvgl_dma2d_hdl, &in_frame, &out_frame);
+            tal_dma2d_wait_finish(sg_lvgl_dma2d_hdl, 1000);
+            continue;
+        }
+#endif
+        {
+            const uint8_t *s = src_frame + ((size_t)r->y1 * stride +
+                                            (size_t)r->x1 * bpp);
+            uint8_t       *d = dst_frame + ((size_t)r->y1 * stride +
+                                            (size_t)r->x1 * bpp);
+            uint32_t row = w * bpp;
+
+            for (uint32_t y = 0; y < h; y++) {
+                memcpy(d, s, row);
+                s += stride;
+                d += stride;
+            }
+        }
+    }
+}
+
 /**********************
  *  INTERFACE IMPL
  **********************/
@@ -244,6 +376,10 @@ void lv_port_flush_init(LV_DISP_NODE_T *node)
         TUYA_CALL_ERR_LOG(tal_dma2d_init(&sg_lvgl_dma2d_hdl));
     }
 #endif
+
+    /* 脏矩形同步：首上电没有"上一帧"可对账，先置 first（第一次必然整屏拷）*/
+    memset(&s_fb_dirty, 0, sizeof(s_fb_dirty));
+    s_fb_dirty.first = true;
 }
 
 void lv_port_flush_execute(LV_DISP_NODE_T *node, lv_display_t *disp,
@@ -253,14 +389,41 @@ void lv_port_flush_execute(LV_DISP_NODE_T *node, lv_display_t *disp,
 
     __disp_fill_display_framebuffer(area, color_ptr, cf, node->disp_fb, node->dev_info.is_swap);
 
+    /* area 已是面板坐标（disp_flush 里转过）：先记账，换 fb 时只同步这些 */
+    __disp_dirty_add(area, node->disp_fb);
+
     if (lv_display_flush_is_last(disp)) {
         tdl_disp_dev_flush(node->dev_hdl, node->disp_fb);
 
         TDL_DISP_FRAME_BUFF_T *next_fb = tdl_disp_get_free_fb(node->fb_mag);
         if (next_fb && next_fb != node->disp_fb) {
-            __disp_framebuffer_memcpy(&node->dev_info, next_fb->frame,
-                                      node->disp_fb->frame, node->disp_fb->len);
+            /* 池子正好把"上一帧"那块还回来（ISR 换帧时释放的）-> next_fb 里
+             * 就是上一帧的完整画面，只把本轮脏矩形同步进去即与 disp_fb 一致。
+             * 首上电 / 脏矩形溢出 / 池子顺序异常 / 非 RGB 面板 -> 整屏拷贝。 */
+            if (!s_fb_dirty.first && !s_fb_dirty.overflow &&
+                next_fb == s_fb_dirty.last_disp_fb &&
+                (TUYA_PIXEL_FMT_RGB565 == node->dev_info.fmt ||
+                 TUYA_PIXEL_FMT_RGB888 == node->dev_info.fmt)) {
+                __disp_fb_rect_copy(&node->dev_info, next_fb->frame,
+                                    node->disp_fb->frame,
+                                    s_fb_dirty.rect, s_fb_dirty.n);
+            } else {
+                __disp_framebuffer_memcpy(&node->dev_info, next_fb->frame,
+                                          node->disp_fb->frame, node->disp_fb->len);
+            }
+            s_fb_dirty.last_disp_fb = node->disp_fb;
+            s_fb_dirty.first = false;
             node->disp_fb = next_fb;
+
+            /* 一轮刷新结束：清单清空，下一轮重新累计 */
+            s_fb_dirty.n = 0;
+            s_fb_dirty.overflow = false;
+        } else {
+            /* 没换成（没有空闲 fb / 面板带 VRAM）：下一轮没有可对账的"上一帧"，
+             * 置 first 逼一次整屏拷贝，免得拿隔帧的内容当底。 */
+            s_fb_dirty.first = true;
+            s_fb_dirty.n = 0;
+            s_fb_dirty.overflow = false;
         }
     }
 
@@ -279,6 +442,12 @@ void lv_port_flush_on_enable(LV_DISP_NODE_T *node)
             node->disp_fb = next_fb;
         }
     }
+
+    /* 显示恢复：上一帧对账关系作废，下一轮从整屏拷贝重新开始 */
+    s_fb_dirty.last_disp_fb = NULL;
+    s_fb_dirty.first = true;
+    s_fb_dirty.n = 0;
+    s_fb_dirty.overflow = false;
 }
 
 void lv_port_flush_release(LV_DISP_NODE_T *node)
@@ -287,6 +456,11 @@ void lv_port_flush_release(LV_DISP_NODE_T *node)
         tdl_disp_fb_manage_release(&node->fb_mag);
         node->fb_mag = NULL;
     }
+    /* fb 池子没了：对账指针必须清掉，下一轮 flush_init 会重建 */
+    s_fb_dirty.last_disp_fb = NULL;
+    s_fb_dirty.first = true;
+    s_fb_dirty.n = 0;
+    s_fb_dirty.overflow = false;
 }
 
