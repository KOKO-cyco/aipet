index 5d3b9615..5581a66c 100755
--- a/src/peripherals/audio_codecs/tdd_audio/src/tdd_audio.c
+++ b/src/peripherals/audio_codecs/tdd_audio/src/tdd_audio.c
@@ -61,6 +61,20 @@ static TDD_AUDIO_DATA_HANDLE_T *g_tdd_audio_hdl = NULL;
 
 static int __tkl_audio_frame_put(TKL_AUDIO_FRAME_INFO_T *pframe)
 {
+    /* [probe] mic 帧到达 tdd 层的计数（每 100 帧 = 2s 打一条）。
+     * 有数 = BK 管线 -> tkl -> tdd 链路通；无数 = 管线没出帧。 */
+#ifndef AI_VOICE_TRACE
+#define AI_VOICE_TRACE 0
+#endif
+#if AI_VOICE_TRACE
+    static uint32_t s_probe_cnt = 0;
+    if ((++s_probe_cnt % 100) == 0) {
+        PR_NOTICE("[probe] tdd frame_put=%u hdl=%p cb=%p",
+                  (unsigned)s_probe_cnt, g_tdd_audio_hdl,
+                  (g_tdd_audio_hdl ? (void *)g_tdd_audio_hdl->mic_cb : NULL));
+    }
+#endif
+
     if (NULL == g_tdd_audio_hdl) {
         return 0;
     }
diff --git a/src/peripherals/display/tdd_display/src/rgb/tdd_disp_rgb_ili9488.c b/src/peripherals/display/tdd_display/src/rgb/tdd_disp_rgb_ili9488.c
index 140b1856..194833a1 100644
--- a/src/peripherals/display/tdd_display/src/rgb/tdd_disp_rgb_ili9488.c
+++ b/src/peripherals/display/tdd_display/src/rgb/tdd_disp_rgb_ili9488.c
@@ -46,7 +46,38 @@ const uint8_t cILI9488_INIT_SEQ[] = {
 static TDD_DISP_RGB_CFG_T sg_disp_rgb = {
     .cfg =
         {
-            .clk = 15000000,
+            /* RGB pixel clock. Frame size incl. blanking is
+             *   (320 + hbp 80 + hfp 80 + hpw 20) * (480 + vbp 8 + vfp 8 + vpw 4)
+             * = 500 * 500 = 250000 clocks, so refresh = clk / 250000:
+             *   8MHz -> 32Hz, 10MHz -> 40Hz, 15MHz -> 60Hz, 20MHz -> 80Hz.
+             * (Only the discrete values in tkl_rgb.c's
+             *  __rgb_ty_clk_to_bk_clk() switch are accepted; anything else
+             *  silently falls through to 30MHz.)
+             *
+             * 20MHz / 80Hz. The panel MUST refresh noticeably faster than the
+             * emulator produces frames, for three separate reasons:
+             *
+             *  1. tdd_display_rgb's __rgb_display_frame() hands the next buffer
+             *     over and then blocks on flush_sem until a panel frame ends, so
+             *     the rgb_task drains at most ONE flush per panel frame. If the
+             *     panel is slower than the producer, the flush queue backs up and
+             *     __tdd_display_rgb_flush()'s tal_queue_post(SEM_WAIT_FOREVER)
+             *     stalls the producer's frame loop. That is what capped the NES
+             *     emulator at ~57fps and, because audio production is tied 1:1 to
+             *     emulated frames, drained the speaker ring buffer until the
+             *     music stuttered continuously.
+             *  2. With double buffering, the ping-pong swap must complete before
+             *     the producer starts writing the other buffer, otherwise it
+             *     tears into the buffer still being scanned. A panel period
+             *     shorter than the emulator's frame period guarantees that.
+             *  3. A 40Hz panel simply cannot show 60 frames per second.
+             *
+             * At 80Hz against a 60.099Hz emulator there is 33% headroom. Cost is
+             * PSRAM read bandwidth (320*480*2 * 80/s = 24.6MB/s); the NES core
+             * idles at ~85%, so that is free.
+             * NOTE: this is a shared SDK driver, so it affects every board
+             * using the ILI9488 RGB path. */
+            .clk = 20000000,
             .out_data_clk_edge = TUYA_RGB_DATA_IN_RISING_EDGE,
             .pixel_fmt = TUYA_PIXEL_FMT_RGB565,
             .hsync_back_porch = 80,
diff --git a/src/peripherals/tp/tdd_tp/include/tdd_tp_gt1151.h b/src/peripherals/tp/tdd_tp/include/tdd_tp_gt1151.h
index f4411f92..dc2c493a 100644
--- a/src/peripherals/tp/tdd_tp/include/tdd_tp_gt1151.h
+++ b/src/peripherals/tp/tdd_tp/include/tdd_tp_gt1151.h
@@ -32,8 +32,16 @@ extern "C" {
 #define GT1151_REG_LEN       (2)
 #define GT1151_MAX_TP_NUM (5)
 
+/* Point count the driver reads per transaction.
+ *
+ * The #ifndef fallback used to be (1), which silently capped EVERY caller to a
+ * single point: read_num = MIN(max_num, GT1151_POINT_INFO_NUM) = 1, even when
+ * the app asked for more and the GT1151 reports up to 5 (status & 0x0f). The
+ * virtual gamepad in the heikesong project needs >= 2 (hold a direction + tap
+ * an action button), so the fallback now follows the controller's real
+ * capability. Defining TP_SUPPORT_MAX_NUM globally still wins if set. */
 #ifndef TP_SUPPORT_MAX_NUM
-#define GT1151_POINT_INFO_NUM (1)
+#define GT1151_POINT_INFO_NUM (GT1151_MAX_TP_NUM)
 #else
 #define GT1151_POINT_INFO_NUM (TP_SUPPORT_MAX_NUM)
 #endif
