diff --git a/src/audio_player/src/svc_ai_player.c b/src/audio_player/src/svc_ai_player.c
index ab9ee728..bf806a2e 100755
--- a/src/audio_player/src/svc_ai_player.c
+++ b/src/audio_player/src/svc_ai_player.c
@@ -560,7 +560,10 @@ OPERATE_RET tuya_ai_player_service_init(AI_PLAYER_CFG_T *cfg)
 {
     OPERATE_RET rt = OPRT_OK;
 
-    TUYA_CALL_ERR_RETURN(tal_queue_create_init(&s_ai_player_ctx.queue, SIZEOF(AI_PLAYER_MSG_T), 2));
+    /* 原来只有 2 格：玩家任务正忙时 post 会直接失败，START/STOP/EXIT/DEINIT
+     * 这些命令会被静默丢掉（现场就是丢 DEINIT，见下面的重试窗口）。
+     * AI_PLAYER_MSG_T 才 12 字节，放大到 8 格几乎零成本。 */
+    TUYA_CALL_ERR_RETURN(tal_queue_create_init(&s_ai_player_ctx.queue, SIZEOF(AI_PLAYER_MSG_T), 8));
 
     THREAD_CFG_T thread_cfg = {0};
     thread_cfg.stackDepth = AI_PLAYER_STACK_SIZE;
@@ -593,12 +596,43 @@ OPERATE_RET tuya_ai_player_service_init(AI_PLAYER_CFG_T *cfg)
 OPERATE_RET tuya_ai_player_service_deinit(void)
 {
     OPERATE_RET rt = OPRT_OK;
+    uint32_t waited = 0;
+
+    /* 已经拆过/从没起过：直接返回，别去碰 free 过的队列 */
+    if (NULL == s_ai_player_ctx.queue) {
+        return OPRT_OK;
+    }
 
     AI_PLAYER_MSG_T msg = {0};
     msg.mode = AI_PLAYER_MODE_FOREGROUND;
     msg.cmd  = PLAYER_CMD_SERVICE_DEINIT;
-    TUYA_CALL_ERR_RETURN(tal_queue_post(s_ai_player_ctx.queue, &msg, 0));
-    return OPRT_OK;
+
+    /* 队列只有 2 格，玩家任务一旦正忙，tal_queue_post(...,0) 就会直接失败：
+     * 现场 log/AI回复中途退出会崩溃.txt 里那两条 ret:-26369 就是它（队列满，
+     * 拆机命令被丢掉 -> ai_player 任务与 consumer 一直挂着，下次进角色页
+     * 再 init 就冲突）。这里给一个很小的重试窗口，把"丢命令"变成"最多多等"。 */
+    while (OPRT_OK != tal_queue_post(s_ai_player_ctx.queue, &msg, 0)) {
+        if (waited >= 100) {
+            PR_ERR("ai player deinit cmd lost, queue busy %ums", waited);
+            return OPRT_OS_ADAPTER_QUEUE_SEND_FAIL;
+        }
+        tal_system_sleep(10);
+        waited += 10;
+    }
+
+    /* 再等它真的拆完。__cmd_player_service_deinit() 末尾会 memset 整个
+     * s_ai_player_ctx（queue 变成 NULL）。不等就返回的话，调用方紧接着
+     * 就会去重开 codec / 重新 init，跟 consumer.close() 与 ctx 清零撞车。 */
+    while ((NULL != s_ai_player_ctx.queue) && (waited < 500)) {
+        tal_system_sleep(10);
+        waited += 10;
+    }
+    if (NULL != s_ai_player_ctx.queue) {
+        PR_ERR("ai player service not deinit in %ums", waited);
+        rt = OPRT_TIMEOUT;
+    }
+
+    return rt;
 }
 
 /**
@@ -659,16 +693,44 @@ OPERATE_RET tuya_ai_player_destroy(AI_PLAYER_HANDLE handle)
 {
     OPERATE_RET rt = OPRT_OK;
     AI_PLAYER_T *player = (AI_PLAYER_T *)handle;
+    uint32_t waited = 0;
 
     if (!__is_player_valid(player)) {
         return OPRT_INVALID_PARM;
     }
 
+    /* 先把 mode 存成局部量：下面等释放的过程中 player 这块内存就不存在了 */
+    AI_PLAYER_MODE_E mode = (AI_PLAYER_MODE_E)player->mode;
+
     AI_PLAYER_MSG_T msg = {0};
-    msg.mode = player->mode;
+    msg.mode = mode;
     msg.cmd  = PLAYER_CMD_EXIT;
-    TUYA_CALL_ERR_RETURN(tal_queue_post(s_ai_player_ctx.queue, &msg, 0));
-    return OPRT_OK;
+
+    /* 队列满时 post 会直接失败 = 这条 EXIT 被丢掉 -> player 永不释放，下一次
+     * tuya_ai_player_create() 因为 player[mode] 还占着而返回 INVALID_PARM
+     * （表现：退出角色页再进去就"没办法继续对话"）。给一个短重试窗口。 */
+    while (OPRT_OK != tal_queue_post(s_ai_player_ctx.queue, &msg, 0)) {
+        if (waited >= 100) {
+            PR_ERR("ai player exit cmd lost, queue busy %ums", waited);
+            return OPRT_OS_ADAPTER_QUEUE_SEND_FAIL;
+        }
+        tal_system_sleep(10);
+        waited += 10;
+    }
+
+    /* 再等它真的被释放（__cmd_player_exit 会把 player[mode] 置 NULL）。
+     * destroy 语义上就该是"返回即已销毁"：不等的话调用方回头就重建/重开
+     * codec，会和 consumer.close() 撞在一起。 */
+    while ((NULL != s_ai_player_ctx.player[mode]) && (waited < 500)) {
+        tal_system_sleep(10);
+        waited += 10;
+    }
+    if (NULL != s_ai_player_ctx.player[mode]) {
+        PR_ERR("ai player not destroyed in %ums", waited);
+        return OPRT_TIMEOUT;
+    }
+
+    return rt;
 }
 
