--- a/src/tuya_ai_service/svc_ai_agent/src/tuya_ai_output.c
+++ b/src/tuya_ai_service/svc_ai_agent/src/tuya_ai_output.c
@@ -62,9 +62,69 @@ typedef struct {
 } AUDIO_PLAYER_CTX_T;
 STATIC AUDIO_PLAYER_CTX_T ai_output_ctx;
 
+/* 出口线程的生命周期标记。deinit 必须"同步"等线程收尾，否则调用方紧接着
+ * Free 掉的播放器/datasink 会被这个线程踩到（见下面 deinit 的注释）。 */
+STATIC volatile BOOL_T   s_out_started = FALSE;   /* 线程是否起过 */
+STATIC volatile BOOL_T   s_out_gone    = FALSE;   /* 线程是否已收尾完毕 */
+STATIC volatile UINT32_T s_out_cb_busy = 0;       /* >0：正卡在回调里（计数，可重入）*/
+
 VOID tuya_ai_output_deinit(VOID)
 {
+    UINT32_T waited = 0;
+
     ai_output_ctx.terminate = TRUE;
+
+    if (FALSE == s_out_started) {
+        return;
+    }
+
+    /* **必须等线程真的收尾**。出口线程此刻可能正卡在
+     * tuya_ai_output_media() -> __ai_agent_media_data_cb() -> 播放器里；
+     * 而调用方（ai_chat_deinit -> ai_audio_player_deinit）回来就把
+     * player / datasink 全部 Free 掉。只置标志不等 = use-after-free：
+     * 现场见 log/AI回复中途退出会崩溃.txt ——
+     *   BusFault 精确数据访问违例, BFAR=0xdcdcdce4, thread=ai_agent_output,
+     *   pc=xQueueTakeMutexRecursive (ldr r6,[r4,#8], r4=0xdcdcdcdc)。
+     * 0xDC 是释放后填充值，锁的就是已经被 Free 的 datasink 互斥量。 */
+    while (waited < 1000) {
+        if (s_out_gone && (0 == s_out_cb_busy)) {
+            break;
+        }
+        tal_system_sleep(5);
+        waited += 5;
+    }
+    s_out_started = FALSE;
+    if (waited >= 1000) {
+        PR_ERR("ai output thread not stopped in %ums", waited);
+    }
+}
+
+/**
+ * @brief 停 AI 出口管线并**等到在途回调返回**（同步版 stop）
+ *
+ * 用途：在拆除播放器/音频栈之前调用。只做两件事，不碰线程本体：
+ *   1. tuya_ai_output_stop(TRUE) —— 状态回 IDLE、清 ring、发 END，
+ *      出口线程下一圈就不会再回调播放器，网络侧新数据也被 write() 丢弃；
+ *   2. 等在途的那一次回调返回（它可能正深在播放器的 datasink 喂数据）。
+ * 线程本体仍由 tuya_ai_output_deinit() 收，两者职责分开。
+ *
+ * @return OPRT_OK 已静默；OPRT_TIMEOUT 回调迟迟不返回（记日志，调用方自行决定）
+ */
+OPERATE_RET tuya_ai_output_stop_sync(VOID)
+{
+    UINT32_T waited = 0;
+
+    tuya_ai_output_stop(TRUE);
+
+    while ((s_out_cb_busy > 0) && (waited < 300)) {
+        tal_system_sleep(2);
+        waited += 2;
+    }
+    if (waited >= 300) {
+        PR_ERR("ai output media cb still busy %ums", waited);
+        return OPRT_TIMEOUT;
+    }
+    return OPRT_OK;
 }
 
