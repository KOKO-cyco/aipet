+/**
+@brief Deinitialize AI chat module
+@return OPERATE_RET Operation result
+
+NOTE: adapted for THIS SDK snapshot. The upstream (other-machine) version keys off
+a dedicated sg_ai_chat_inited flag and calls tkl_kws_deinit(); this snapshot tracks
+readiness with sg_ai_agent_inited and has no tkl_kws_deinit() implementation, so it
+is intentionally omitted here.
+*/
+OPERATE_RET ai_chat_deinit(void)
+{
+    if (false == sg_ai_chat_inited) {
+        return OPRT_OK;
+    }
+    sg_ai_chat_inited = false;
+    sg_ai_agent_inited = false;
+
+#if defined(ENABLE_BUTTON) && (ENABLE_BUTTON == 1)
+    if (sg_button_hdl) {
+        /* without_hardware keeps the TDL node the tdd device registered at
+         * boot, so the NEXT ai_chat_init() does not fail with
+         * "button no existence". */
+        tdl_button_delete_without_hardware(sg_button_hdl);
+        sg_button_hdl = NULL;
+    }
+#endif
+
+    /* stop the mode task: its loop exits once the thread state leaves
+     * THREAD_STATE_RUNNING. */
+    if (sg_ai_chat_mode_task) {
+        tal_thread_delete(sg_ai_chat_mode_task);
+        sg_ai_chat_mode_task = NULL;
+    }
+
+#if defined(ENABLE_COMP_AI_AUDIO) && (ENABLE_COMP_AI_AUDIO == 1)
+    tal_event_unsubscribe(EVENT_AUDIO_VAD, "vad_change", __ai_vad_change_evt);
+    tal_event_unsubscribe(EVENT_AI_CLIENT_RUN, "client_run", ai_mode_client_run);
+
+    /* **拆音频栈之前必须先把 AI 出口管线停干净**。
+     * ai_agent_output 线程的 media_data_cb -> __ai_agent_media_data_cb ->
+     * ai_audio_play_tts_stream() 会一直往播放器里喂 TTS，而它直到最后
+     * ai_agent_deinit() 才被要求退出（且是异步的）。中途退出对话时，
+     * ai_audio_player_deinit() 投递的 PLAYER_CMD_EXIT 会被 ai_player 任务
+     * 先执行 —— datasink 与 player 被 Free（内存填 0xDC），出口线程下一脚
+     * tal_mutex_lock(ctx->mutex) 就踩上去：
+     *   BusFault 精确数据访问违例 BFAR=0xdcdcdce4，thread=ai_agent_output，
+     *   pc=xQueueTakeMutexRecursive(ldr r6,[r4,#8], r4=0xdcdcdcdc)，rr:0x13。
+     * 现场日志：log/AI回复中途退出会崩溃.txt。
+     * stop_sync() 会强制停管线并等在途回调返回，之后拆播放器才是安全的。 */
+    tuya_ai_output_stop_sync();
+
+    ai_audio_player_deinit();
+    ai_audio_input_deinit();
+    /* tkl_kws_deinit() is not implemented in this SDK snapshot -- omitted on
+     * purpose. Re-add the call once the kws adapter gains a deinit. */
+#endif
+
+    ai_mode_deinit();
+    ai_agent_deinit();
+
+    /* EVENT_MQTT_CONNECTED stays subscribed on purpose */
+
+    PR_DEBUG("ai chat deinit");
+
+    return OPRT_OK;
+}
